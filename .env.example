# Copia a .env e introduce los valores solo en tu equipo.
# Supabase: sesión del pooler en IPv4. Usa el usuario de aplicación con permisos limitados.
DATABASE_URL=postgresql://USUARIO.REFERENCIA:CLAVE_CODIFICADA@HOST_DEL_POOLER:5432/postgres
DATABASE_SSL=true
DATABASE_CA_FILE=./certs/supabase-ca.crt
API_HOST=127.0.0.1
API_PORT=3001
STATS_ADMIN_PASSWORD=
