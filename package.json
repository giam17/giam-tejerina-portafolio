{
  "name": "giam-tejerina-portafolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "node --env-file-if-exists=.env dist-server/server/index.js",
    "test:unit": "tsx --test tests/unit/analytics.test.ts",
    "test:integration": "tsx --test tests/integration/api.test.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@fontsource/bowlby-one": "^5.3.0",
    "@fontsource/bowlby-one-sc": "^5.3.0",
    "@fontsource/bungee-shade": "^5.3.0",
    "@fontsource/changa-one": "^5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/denk-one": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/league-spartan": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sedgwick-ave-display": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "motion": "14.0.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
